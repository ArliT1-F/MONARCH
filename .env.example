# ── Monarch environment ─────────────────────────────────────────────
# Copy to .env (bot) and apps/dashboard/.env.local (dashboard).
#
# For Vercel deployment see docs/deploying-vercel.md — env vars live in the
# Vercel project settings, not in files.

DISCORD_CLIENT_ID=
# Your own Discord user id (Developer Mode → right-click your name → Copy
# User ID). Targeting it with /burg uno-reverses the gag onto the invoker.
# Must also be set on the bot worker (render.yaml / docker-compose pass it
# through) — without it you can be burg'd like anyone else.
MONARCH_OWNER_USER_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Optional while testing: register slash commands in this server immediately
# instead of waiting for Discord's global command propagation (up to an hour).
DISCORD_GUILD_ID=

# Where Discord should redirect after OAuth (must be registered in the
# Discord developer portal): {APP_URL}/api/auth/callback
APP_URL=http://localhost:3000

# Secret used to sign Monarch session cookies AND encrypt OAuth tokens at
# rest (PrismaStore, AES-256-GCM). Generate with:
#   openssl rand -hex 32
SESSION_SECRET=dev-only-secret-change-me

# PostgreSQL. When unset, Monarch falls back to a local file store
# (./.monarch-data) intended for development/demo only — NOT on Vercel /
# serverless, where the filesystem is readonly and DATABASE_URL is required.
#
# Local / Docker (plain Postgres, no pooler — one URL is enough):
#   DATABASE_URL=postgresql://monarch:monarch@localhost:5432/monarch
#
# Serverless / pooled (Neon, Vercel Postgres, Supabase pgbouncer):
#   DATABASE_URL = the POOLED connection string (used by the dashboard)
#   DIRECT_DATABASE_URL = the DIRECT connection string (used by migrations)
DATABASE_URL=postgresql://neondb_owner:npg_PSRTHI5Oxp4N@ep-curly-bonus-au6km15k-pooler.c-10.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DIRECT_DATABASE_URL=

# Force demo mode even if credentials are present (1/0)
MONARCH_DEMO=

# Shared secret between the dashboard and the bot — powers the bot's
# server-to-server calls to /api/internal/* (/monarch backup, /monarch export,
# /monarch embed, /monarch test, and saving a server's custom command prefix
# with !prefix set). The SAME value must be set in the dashboard and the bot
# environments. Generate with:  openssl rand -hex 32
INTERNAL_API_TOKEN=

# ── Music player (bot) ───────────────────────────────────────────────
# /music plays through a Lavalink node: a small JVM service that owns the
# Discord voice socket, fetches the audio (YouTube through the youtube-source
# plugin, plus SoundCloud/Bandcamp/Twitch/direct URLs) and encodes Opus. The
# bot only tells it what to play over websocket + REST — no ffmpeg, no yt-dlp,
# no native modules in the bot process.
#
# Running a node — pick ONE (no Docker needed):
#   1) npm run music:local
#      → runs Lavalink locally WITHOUT Docker (needs Java 17+, 512M RAM)
#      Downloads Lavalink.jar 4.2.2 into .lavalink/, copies application.yml, runs java
#      Perfect if Docker crashes your laptop — see scripts/run-lavalink-local.mjs
#   2) docker compose -f docker/docker-compose.yml up -d lavalink
#      → bundled `lavalink` service (config: docker/lavalink/application.yml)
#      Inside Docker bot uses ws://lavalink:2333, outside uses localhost:2333
#   3) ./deploy/laptop-install.sh
#      → installs Lavalink as a systemd user service next to the bot (needs Java 17+)
#   4) anywhere else → point LAVALINK_NODES at it
#
# Quick diagnostics if you see "Couldn't reach the Lavalink node at localhost:2333":
#   npm run music:check          → checks if node answers at your configured host
#   npm run music:local          → runs Lavalink WITHOUT Docker (Java only, low RAM)
#   npm run music:up             → starts bundled node via Docker
#   npm run music:logs           → docker logs monarch-lavalink -f
#   curl http://localhost:2333/version -H "Authorization: $LAVALINK_PASSWORD"
#   See docs/troubleshooting-music.md for full guide (Docker + no-Docker)
#
# LAVALINK_NODES is comma-separated, each `[name@][ws|wss|http|https://]host[:port]`:
#   LAVALINK_NODES=ws://localhost:2333
#   LAVALINK_NODES=eu@ws://10.0.0.5:2333,us@wss://music.example.com
# With several nodes the bot picks the least-loaded reachable one per guild and
# fails over when one drops. Leave blank to use LAVALINK_HOST/LAVALINK_PORT
# (default ws://localhost:2333 — what the bundled compose service expects).
#
# IMPORTANT: docker compose now reads .env from BOTH ../.env and .env thanks to
# env_file in docker/docker-compose.yml, so you can run from repo root OR from
# docker/ folder. If you still get fetch failed, the node is simply not running.
LAVALINK_NODES=
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
# TLS: implied by a wss:// or https:// URL in LAVALINK_NODES, otherwise set 1.
LAVALINK_SECURE=
# Must equal `lavalink.server.password` in the node's application.yml. Blank
# means Lavalink's published default, which the bot warns about at boot: never
# expose a node with it on the public internet.
# Generate with: openssl rand -hex 32
LAVALINK_PASSWORD=
# How long a node keeps this bot's session resumable while it reconnects, in
# seconds. Coming back inside that window resumes every guild's playback
# instead of re-joining voice from scratch.
LAVALINK_RESUME_SECONDS=60
# Reconnect backoff bounds, milliseconds (1 s → 30 s by default).
LAVALINK_RECONNECT_MIN_MS=
LAVALINK_RECONNECT_MAX_MS=
# Name shown in the node's client list. Default: monarch-bot/<version>.
LAVALINK_CLIENT_NAME=

# Which node-side search `play <words>` uses for queries that are not links:
# ytsearch (YouTube), ytmsearch (YouTube Music) or scsearch (SoundCloud).
MUSIC_SEARCH_PREFIX=ytsearch

# Spotify support: create a (free) app at developer.spotify.com/dashboard,
# add http://localhost:3000 or your host URL as a redirect URI (required by
# the dashboard even though the bot only uses client credentials), and put
# the client id/secret here. A Spotify link is read for its metadata and then
# matched to YouTube on the node at play time, so without these credentials
# every /music command still works except Spotify links.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Who can /music skip without a vote — role NAMES (case-insensitive,
# comma-separated). Staff also covers anyone with real moderation
# permissions (Manage Server, Timeout/Kick/Ban Members, Move Members) and
# whoever queued the current track. Defaults: dj | moderator, moderators,
# mod, mods, staff, admin, admins, administrator, administrators
MUSIC_DJ_ROLE_NAMES=dj
MUSIC_STAFF_ROLE_NAMES=moderator,moderators,mod,mods,staff,admin,admins,administrator,administrators

# Queue limits (bot): max tracks per server queue / max tracks imported
# from a single YouTube or Spotify playlist.
MUSIC_MAX_QUEUE=500
MUSIC_MAX_PLAYLIST_TRACKS=250

# ── Prefix (text) commands (bot) ───────────────────────────────────────
# Every command also answers to a plain message: !help, !play <song>,
# !burg @user, !backup, or "@Monarch help". Nothing to configure — the default
# prefix is "!" (DEFAULT_COMMAND_PREFIX in packages/shared/src/prefix.ts) and
# mentioning the bot always works.
#
# The "no danger" commands are open to every member: !help, !dashboard,
# !status, !prefix (showing it) and !invite — the last one posts the same
# "Add Monarch to Discord" link the dashboard's invite button uses, so anybody
# can put the bot on a server they own. !invite needs an application id:
# DISCORD_CLIENT_ID (above) or, failing that, the bot's own user id, which is
# the same snowflake.
#
# Per server, not per deployment: members with Manage Server change it in
# Discord with `!prefix set ?` / `!prefix set m!` / `!prefix reset`, and it is
# stored on GuildSettings.commandPrefix through /api/internal/guilds/:id/prefix
# (so INTERNAL_API_TOKEN must be set, and `npm run db:migrate` must have run —
# the column arrives with 20260912000000_add_command_prefix). Without the
# token the bot still accepts the default prefix and says what is missing.
#
# Prefix commands need the privileged "Message Content" intent, exactly like
# the burg relay: without it the bot runs slash-only.
#
# Confessions work the same way: `/monarch confession setup [channel] [logs]`
# stores the confession channel (and optional staff log channel) on
# GuildSettings.confessionChannelId / confessionLogChannelId through
# /api/internal/guilds/:id/confession (so INTERNAL_API_TOKEN must be set, and
# `npm run db:migrate` must have run — the columns arrive with
# 20260912120000_add_confession_channels). Confessing itself (the Confess
# button on any confession) is open to every member.

# Bot notes (no variables, but easy to miss):
# - /burg and every prefix command need the privileged
#   "Message Content" gateway intent: Discord developer portal → Bot →
#   Privileged Gateway Intents. Without it the bot still runs (Guilds-only),
#   /burg explains why, and text commands never fire.
# - The invite link now requests "Manage Messages" for the burg relay;
#   servers that installed Monarch earlier must re-run the invite or
#   grant it.
# - The music player needs the "Server Voice States" intent (enabled by
#   default, not privileged) and a reachable Lavalink node (LAVALINK_NODES
#   above). Nothing else — no ffmpeg, no yt-dlp, no native audio modules to
#   build. With no node the worker still boots and every other command works;
#   /music answers that the music backend is down.
# - Voice audio is UDP, and it is the *node's* host that needs outbound UDP,
#   not the bot's. A Render or Vercel-style container can therefore run /music
#   as long as LAVALINK_NODES points at a node on a VPS, a Fly.io machine, or
#   your own always-on laptop — the node itself cannot run on Render, whose
#   containers have no UDP egress. `deploy/laptop-install.sh` sets up both
#   units on one machine, see docs/hosting-laptop.md.
# - The node is a JVM app: Java 17+ (21 recommended). docker compose uses the
#   official ghcr.io/lavalink-devs/lavalink:4 image; laptop-install.sh
#   downloads Lavalink.jar and writes a systemd user unit for it. Its config
#   (docker/lavalink/application.yml) is where YouTube client order, IP
#   rotation and OAuth/poToken workarounds live if YouTube ever pushes back.
# - APP_URL is not "where the bot lives", it is where the *dashboard* lives: the
#   bot has no database, so backup/export/embed/test/prefix/confessions are all
#   calls to APP_URL. Running the worker on a laptop changes nothing about that,
#   so keep it pointed at the deployed dashboard, not localhost.