# ── Monarch environment ─────────────────────────────────────────────
# Copy to .env (bot) and apps/dashboard/.env.local (dashboard).

# Discord application (OAuth2 + bot). Leave empty to run in DEMO MODE:
# the dashboard boots with mock guilds and a mock Discord gateway so the
# full design → diff → apply loop can be exercised without credentials.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Where Discord should redirect after OAuth (must be registered in the
# Discord developer portal): {APP_URL}/api/auth/callback
APP_URL=http://localhost:3000

# Secret used to sign Monarch session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=dev-only-secret-change-me

# PostgreSQL. When unset, Monarch falls back to a local file store
# (./.monarch-data) intended for development/demo only.
DATABASE_URL=

# Force demo mode even if credentials are present (1/0)
MONARCH_DEMO=
