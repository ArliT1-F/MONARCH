# ── Monarch environment ─────────────────────────────────────────────
# Copy to .env (bot) and apps/dashboard/.env.local (dashboard).
#
# For Vercel deployment see docs/deploying-vercel.md — env vars live in the
# Vercel project settings, not in files.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Optional while testing: register slash commands in this server immediately
# instead of waiting for Discord's global command propagation (up to an hour).
DISCORD_GUILD_ID=

# Where Discord should redirect after OAuth (must be registered in the
# Discord developer portal): {APP_URL}/api/auth/callback
APP_URL=http://localhost:3000

# Secret used to sign Monarch session cookies AND encrypt OAuth tokens at
# rest (PrismaStore, AES-256-GCM). Generate with:
#   openssl rand -hex 32
SESSION_SECRET=dev-only-secret-change-me

# PostgreSQL. When unset, Monarch falls back to a local file store
# (./.monarch-data) intended for development/demo only — NOT on Vercel /
# serverless, where the filesystem is readonly and DATABASE_URL is required.
#
# Local / Docker (plain Postgres, no pooler — one URL is enough):
#   DATABASE_URL=postgresql://monarch:monarch@localhost:5432/monarch
#
# Serverless / pooled (Neon, Vercel Postgres, Supabase pgbouncer):
#   DATABASE_URL = the POOLED connection string (used by the dashboard)
#   DIRECT_DATABASE_URL = the DIRECT connection string (used by migrations)
DATABASE_URL=postgresql://neondb_owner:npg_PSRTHI5Oxp4N@ep-curly-bonus-au6km15k-pooler.c-10.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
DIRECT_DATABASE_URL=

# Force demo mode even if credentials are present (1/0)
MONARCH_DEMO=

# Shared secret between the dashboard and the bot — powers the bot's
# server-to-server calls to /api/internal/* (/monarch backup, /monarch export,
# /monarch embed, /monarch test). The SAME value must be set in the dashboard
# and the bot environments. Generate with:  openssl rand -hex 32
INTERNAL_API_TOKEN=

# ── Music player (bot) ───────────────────────────────────────────────
# Spotify support: create a (free) app at developer.spotify.com/dashboard,
# add http://localhost:3000 or your host URL as a redirect URI (required by
# the dashboard even though the bot only uses client credentials), and put
# the client id/secret here. Without them every /music command still works
# except Spotify links.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Who can /music skip without a vote — role NAMES (case-insensitive,
# comma-separated). Staff also covers anyone with real moderation
# permissions (Manage Server, Timeout/Kick/Ban Members, Move Members) and
# whoever queued the current track. Defaults: dj | moderator, moderators,
# mod, mods, staff, admin, admins, administrator, administrators
MUSIC_DJ_ROLE_NAMES=dj
MUSIC_STAFF_ROLE_NAMES=moderator,moderators,mod,mods,staff,admin,admins,administrator,administrators

# Queue limits (bot): max tracks per server queue / max tracks imported
# from a single YouTube or Spotify playlist.
MUSIC_MAX_QUEUE=500
MUSIC_MAX_PLAYLIST_TRACKS=250

# Bot notes (no variables, but easy to miss):
# - /monarch jail needs the privileged "Message Content" gateway intent:
#   Discord developer portal → Bot → Privileged Gateway Intents. Without it
#   the bot still runs (Guilds-only) and the jail command explains why.
# - The invite link now requests "Manage Messages" for the jail relay;
#   servers that installed Monarch earlier must re-run the invite or grant it.
# - The music player needs the "Server Voice States" intent (enabled by
#   default, not privileged) and ffmpeg for audio. The Docker image ships
#   ffmpeg; locally, @ffmpeg-installer/ffmpeg (installed with the bot) is
#   used automatically, or set FFMPEG_PATH to a system binary.